<?xml version="1.0" encoding="utf-8"?>
<!-- Layout principal de la biblioteca con Speed Dial FAB -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/bg_primary">

    <!-- AppBar & Toolbar minimalista -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_toolbar"
        app:liftOnScroll="false"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/bg_toolbar"
            app:title="HTML Viewer"
            app:titleCentered="false"
            app:titleTextColor="@color/text_primary"
            app:subtitleTextColor="@color/text_secondary" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Lista vertical principal (Carrusel de recientes, Carpetas y Archivos) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="100dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        tools:listitem="@layout/item_group_header" />

    <!-- Estado vacío (sin archivos) -->
    <LinearLayout
        android:id="@+id/layout_empty_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        android:paddingHorizontal="32dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_empty_library"
            android:contentDescription="Sin archivos"
            android:layout_marginBottom="24dp"
            app:tint="@color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sin archivos importados"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Toca el botón + para importar archivos o crear carpetas"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:gravity="center" />

    </LinearLayout>

    <!-- Capa oscura de desenfoque/fondo para el Speed Dial -->
    <View
        android:id="@+id/view_dim_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true" />

    <!-- Contenedor Speed Dial FAB -->
    <LinearLayout
        android:id="@+id/layout_speed_dial"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="36dp"
        android:orientation="vertical"
        android:gravity="end|bottom">

        <!-- Opción 1: Nueva Carpeta -->
        <LinearLayout
            android:id="@+id/option_new_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nueva carpeta"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_pill_label"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:layout_marginEnd="12dp"
                android:elevation="4dp" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_option_new_group"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Nueva carpeta"
                app:fabCustomSize="48dp"
                app:maxImageSize="22dp"
                app:srcCompat="@drawable/ic_folder"
                app:backgroundTint="@color/bg_group_header"
                app:tint="@color/white"
                app:elevation="4dp" />

        </LinearLayout>

        <!-- Opción 2: Importar archivo HTML -->
        <LinearLayout
            android:id="@+id/option_import_file"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Importar archivo HTML"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_pill_label"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:layout_marginEnd="12dp"
                android:elevation="4dp" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_option_import_file"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Importar archivo HTML"
                app:fabCustomSize="48dp"
                app:maxImageSize="22dp"
                app:srcCompat="@drawable/ic_file"
                app:backgroundTint="@color/bg_group_header"
                app:tint="@color/white"
                app:elevation="4dp" />

        </LinearLayout>

        <!-- Botón Principal (+) con animación Speed Dial -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_main"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="Opciones de creación"
            app:fabCustomSize="64dp"
            app:maxImageSize="30dp"
            app:srcCompat="@drawable/ic_add"
            app:backgroundTint="@color/white"
            app:tint="@color/black"
            app:elevation="6dp" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>