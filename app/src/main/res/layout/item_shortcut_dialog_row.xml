<?xml version="1.0" encoding="utf-8"?>
<!-- Fila personalizada de opción temática en el diálogo -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="54dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:layout_marginBottom="4dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <!-- Cuadro oscuro con el icono vectorial blanco -->
    <FrameLayout
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_shortcut_icon_tile">

        <ImageView
            android:id="@+id/iv_option_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:contentDescription="Icono"
            app:tint="@color/white" />

    </FrameLayout>

    <!-- Título de la materia / tema -->
    <TextView
        android:id="@+id/tv_option_title"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium" />

    <!-- Radio button minimalista -->
    <RadioButton
        android:id="@+id/rb_option_check"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false"
        app:buttonTint="@color/white" />

</LinearLayout>
